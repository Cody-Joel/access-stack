# Access-Stack environment variables
# Copy this file to .env and fill in the keys you want to use.
# Ollama runs locally — no key needed.
# Groq and Gemini have free tiers.

# ── Free tier ──────────────────────────────────────────────────────
# Groq: fast, free — get key at console.groq.com
GROQ_API_KEY=

# Gemini: free tier 1500 req/day (2.0-flash) — get key at aistudio.google.com
GEMINI_API_KEY=

# ── Paid ───────────────────────────────────────────────────────────
# Anthropic Claude API (separate from Claude Pro subscription)
ANTHROPIC_API_KEY=

# OpenRouter — access many models through one key
OPENROUTER_API_KEY=

# ── NVIDIA NIM (local or cloud) ────────────────────────────────────
NIM_API_KEY=not-needed
NIM_API_BASE=http://localhost:8000/v1

# ── Ollama ─────────────────────────────────────────────────────────
# No key needed. Runs at localhost:11434 by default.
# To expose on your Tailscale network: OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_BASE_URL=http://localhost:11434
